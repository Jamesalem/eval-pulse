# Multi-stage Docker build for EvalPulse API
FROM golang:1.22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /evalpulse-api ./cmd/api

# Final minimal runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S evalpulse && adduser -S -G evalpulse evalpulse

WORKDIR /app
COPY --from=builder /evalpulse-api /app/evalpulse-api

USER evalpulse

EXPOSE 8080

ENTRYPOINT ["/app/evalpulse-api"]
